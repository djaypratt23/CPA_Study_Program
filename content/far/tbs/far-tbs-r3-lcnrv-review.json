        },
        {
          "id": "c",
          "label": "Item C",
          "prepared": 62000,
          "answer": 40000,
          "explanation": "Cost 40,000 is lower than NRV 62,000: **40,000**."
        },
        {
          "id": "d",
          "label": "Item D",
          "prepared": 26000,
