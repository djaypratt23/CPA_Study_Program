          "id": "q1",
          "label": "If Item B's NRV recovers next year, may Westbrook reverse the write-down?",
          "answer": "No",
          "explanation": "U.S. GAAP prohibits reversing inventory write-downs."
        },
        {
          "id": "q2",
          "label": "Would a LIFO company use lower of cost or market instead of NRV?",
          "answer": "Yes",
          "explanation": "LIFO and retail-method inventory still use lower of cost or market."
        }
