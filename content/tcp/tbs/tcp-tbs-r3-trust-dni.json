  "pool": "practice",
  "title": "Complex trust DNI — Halloran Trust",
  "minutes": 25,
  "skill": "analysis",
  "instructions": "The Halloran Trust is a complex trust. Capital gains are allocated to corpus. Trustee fees are allocated proportionally to tax-exempt income. It must distribute **$42,000** this year and does so. Round to the nearest dollar.",
  "exhibits": [
    {
      "title": "2025 trust accounting",
      "content": "Taxable interest: **$40,000**\nQualified dividends: **$20,000**\nTax-exempt interest: **$10,000**\nLong-term capital gain (to corpus): **$15,000**\nTrustee fees: **$7,000**\nPersonal exemption: **$100**"
    }
  ],
  "parts": [
    {
      "kind": "numeric",
      "id": "n",
      "prompt": "Compute the following.",
      "rows": [
        {
          "id": "fee",
          "label": "Deductible trustee fees",
          "answer": 6000,
          "explanation": "7,000 × 60/70 taxable share = **6,000**.",
          "tolerance": 0
        },
        {
          "id": "dni",
          "label": "Distributable net income",
          "answer": 63000,
          "explanation": "40,000 + 20,000 + 10,000 − 7,000 = **63,000** (capital gains excluded).",
          "tolerance": 0
        },
        {
          "id": "te",
          "label": "Tax-exempt portion of the distribution",
          "answer": 6000,
          "explanation": "Net tax-exempt income 9,000 ÷ 63,000 × 42,000 = **6,000**.",
          "tolerance": 0
        },
        {
          "id": "dd",
          "label": "Distribution deduction",
          "answer": 36000,
          "explanation": "42,000 − 6,000 tax-exempt = **36,000**.",
          "tolerance": 0
        },
        {
          "id": "ti",
          "label": "Trust taxable income",
          "answer": 32900,
          "explanation": "75,000 − 6,000 − 36,000 − 100 = **32,900**.",
          "tolerance": 0
        },
        {
          "id": "ben",
          "label": "Taxable income reported by the beneficiary",
          "answer": 36000,
          "explanation": "The beneficiary is taxed on the 36,000 taxable portion.",
          "tolerance": 0
        }
      ]
    }
  ]
}
