    {
      "kind": "numeric",
      "id": "n",
      "prompt": "Compute the following.",
      "rows": [
        {
          "id": "eq",
          "label": "State X apportionment percentage — equally weighted three factors",
          "answer": 28.33,
          "explanation": "(30% + 25% + 30%) ÷ 3 = **28.33%**.",
          "tolerance": 0.01,
          "unit": "%"
        },
        {
          "id": "dw",
          "label": "State X apportionment percentage — double-weighted sales",
          "answer": 28.75,
          "explanation": "(2 × 30% + 25% + 30%) ÷ 4 = **28.75%**.",
          "tolerance": 0.01,
          "unit": "%"
        },
        {
          "id": "ss",
          "label": "State X apportionment percentage — single sales factor",
          "answer": 30,
          "explanation": "3,000,000 ÷ 10,000,000 = **30%**.",
          "tolerance": 0.01,
          "unit": "%"
        },
        {
          "id": "inc",
          "label": "Income apportioned to State X using double-weighted sales",
          "answer": 1437500,
          "explanation": "5,000,000 × 28.75% = **1,437,500**.",
          "tolerance": 0
        }
      ]
    },
