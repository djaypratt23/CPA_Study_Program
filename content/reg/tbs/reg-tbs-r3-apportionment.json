    {
      "title": "Factors",
      "content": "| Factor | State X | Everywhere |\n|---|---|---|\n| Sales | 3,000,000 | 10,000,000 |\n| Property | 2,000,000 | 8,000,000 |\n| Payroll | 1,500,000 | 5,000,000 |"
    }
  ],
